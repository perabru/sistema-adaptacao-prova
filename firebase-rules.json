{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('usuarios').child(auth.uid).child('role').val() === 'coordenacao')",
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() === 'coordenacao' || (auth.uid === $uid && data.exists()))",
        ".validate": "newData.hasChildren(['role','nome','email']) && (!data.exists() || newData.child('role').val() === data.child('role').val() || root.child('usuarios').child(auth.uid).child('role').val() === 'coordenacao')"
      },
      ".indexOn": ["role"]
    },
    "alunos": {
      ".read": "auth != null",
      "$alunoId": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('role').val() === 'coordenacao'",
        "complementoProfessor": {
          ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('role').val() === 'professor' || root.child('usuarios').child(auth.uid).child('role').val() === 'coordenacao')"
        }
      }
    },
    "auditoria": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('role').val() === 'coordenacao'",
      ".write": "auth != null"
    },
    "bancoQuestoes": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('usuarios').child(auth.uid).child('role').val() === 'coordenacao')",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
